# Port for the Gmail Cleaner app (default: 8000)
PORT=8000

# Google OAuth 2.0 Credentials (obtained from Google Cloud Console)
# Alternatively, you can configure these directly in the App UI or place credentials.json in data/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Demo mode (set to true to enable instant mock data preview without Google Cloud keys)
DEMO_MODE=false
