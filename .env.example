# Bind host and port for local execution (Docker overrides HOST=0.0.0.0)
HOST=127.0.0.1
PORT=8000

# Enable hot-reload during local backend development
DEBUG=false

# Google OAuth 2.0 Credentials (obtained from Google Cloud Console)
# Alternatively, configure these in the App UI Settings modal or place credentials.json in data/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Demo mode enables instant sample data simulation when Google Cloud OAuth is not connected
DEMO_MODE=false
